---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FaqItem[];
}

const { title = 'Questions fréquentes', items } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<section class="faq-section container pt-4 pb-4">
  <div class="container-content">
    <h2 class="faq-section__title">{title}</h2>
    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary class="faq-item__question">{item.question}</summary>
          <div class="faq-item__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
