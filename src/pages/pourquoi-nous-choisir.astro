---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  hasHero={true}
  title="Pourquoi Nous Choisir | Photographe & Pilote Drone Certifié Annecy"
  description="40 ans de photographie, pilote drone certifié DGAC depuis 2012, +500 missions. Découvrez pourquoi les collectivités, promoteurs et entreprises de Haute-Savoie nous font confiance."
  preloadImage="/images/parallax/MICHAUD-Seb-158.jpg"
  canonical="/pourquoi-nous-choisir/"
>

   <section class="page-hero">
      <div class="page-hero__image">
         <img src="/images/parallax/MICHAUD-Seb-158.jpg" alt="Photographe et pilote drone professionnel en action" loading="eager">
      </div>
      <div class="page-hero__overlay"></div>
      <div class="page-hero__content">
         <h1 class="page-hero__title">Pourquoi nous choisir</h1>
      </div>
   </section>

   <section class="pnc-intro container pt-5 pb-3">
      <div class="container-content text-center">
         <h2>L'expérience au service de <b>votre projet</b></h2>
         <p>Pas simplement un photographe ou un pilote de drone — un partenaire visuel avec <b>quatre décennies d'expertise</b>, une certification professionnelle et des références qui parlent d'elles-mêmes.</p>
      </div>
   </section>

   <section class="pnc-stats container pb-3">
      <div class="container-medium">
         <div class="pnc-stats__grid">
            <div class="pnc-stat">
               <span class="pnc-stat__number">40+</span>
               <span class="pnc-stat__label">années de photographie</span>
            </div>
            <div class="pnc-stat">
               <span class="pnc-stat__number">500+</span>
               <span class="pnc-stat__label">missions drone réalisées</span>
            </div>
            <div class="pnc-stat">
               <span class="pnc-stat__number">45+</span>
               <span class="pnc-stat__label">pays parcourus</span>
            </div>
            <div class="pnc-stat">
               <span class="pnc-stat__number">2012</span>
               <span class="pnc-stat__label">pilote drone depuis</span>
            </div>
         </div>
      </div>
   </section>

   <section class="pnc-expertise container pt-3 pb-5">
      <div class="container-content">
         <h2 class="text-center mb-2">Ce qui fait la différence</h2>

         <div class="pnc-expertise__grid">

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
               </div>
               <h3>Certifié & Assuré</h3>
               <p>Pilote drone certifié DGAC en catégorie spécifique. Assurance professionnelle RC Pro. Conformité totale avec la réglementation aérienne française et européenne.</p>
            </div>

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <circle cx="12" cy="12" r="10"></circle>
                     <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                  </svg>
               </div>
               <h3>Double expertise</h3>
               <p>Photographe au sol et pilote drone. Une seule personne pour vos prises de vue terrestres et aériennes — cohérence visuelle garantie, logistique simplifiée.</p>
            </div>

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                  </svg>
               </div>
               <h3>Direction artistique</h3>
               <p>Ancien photographe de sports extrêmes pour les plus grands magazines. Un œil créatif forgé par des décennies de storytelling visuel, pas seulement un technicien.</p>
            </div>

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                     <line x1="8" y1="21" x2="16" y2="21"></line>
                     <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
               </div>
               <h3>Production complète</h3>
               <p>De la prise de vue à la post-production — retouche, montage vidéo, étalonnage. Livraison de fichiers prêts à l'emploi pour le print, le web et les réseaux sociaux.</p>
            </div>

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                     <circle cx="12" cy="10" r="3"></circle>
                  </svg>
               </div>
               <h3>Ancrage local</h3>
               <p>Basé à Annecy, je connais chaque recoin de la Haute-Savoie et de la Savoie. Intervention rapide, connaissance des autorisations de vol locales, réseau de contacts établi.</p>
            </div>

            <div class="pnc-expertise__card">
               <div class="pnc-expertise__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                     <circle cx="9" cy="7" r="4"></circle>
                     <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                     <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
               </div>
               <h3>Références solides</h3>
               <p>Grand Annecy, Teractem, Barrachin, France TV, FR3, Le Dauphiné Libéré. Des collectivités aux promoteurs, des médias aux entreprises — une confiance qui dure.</p>
            </div>

         </div>
      </div>
   </section>

   <section class="testimonials-section container pt-5 pb-3">
      <div class="container-slider-slider">
         <div class="slider-slider-header">
            <h3 class="text-center temoignages">Témoignages</h3>
         </div>
         <div class="slider-slider-wrapper">
            <div class="testimonial-slider-track slider-track">
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">"C'est toujours un plaisir de travailler avec Jean-Marc: professionnalisme, disponibilité et bonne humeur sont toujours au rendez-vous. C'est un grand professionnel dont nous apprécions les qualités techniques, artistiques et humaines. Il sait s'adapter à nos contraintes et nos délais dans des contextes variés: aussi à l'aise avec un drone que dans une réunion publique, un cocktail ou sur un chantier!"</p>
                  <p class="testimonial-author"><strong>Véronique Bonnard</strong></p>
                  <p class="testimonial-job">Dir. Comm. Grand Annecy</p>
               </div>
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">"Jean Marc fait preuve d'un grand professionnalisme et de créativité artistique. Je travaille avec lui depuis nombreuses années et il a su évoluer avec les outils de son temps. Il sait s'adapter à la demande : Photos produits, mise en valeur de l'environnement et visites virtuelles. A l'arrivée les photos ou les vidéos sont d'une grande qualité. Un vrai professionnel de l'image"</p>
                  <p class="testimonial-author"><strong>Florence Saki</strong></p>
                  <p class="testimonial-job">Dir. Comm. et Pôle Tourisme Groupe Salin</p>
               </div>
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">"Jean-Marc a ce talent de pouvoir capter l'instant, l'émotion qui a fait son succès dans l'essor des sports de glisse dont il est devenu l'un des photographes iconiques. Avec le drone, son talent s'est élargi dans la vidéo. Au-delà d'être devenu un ami proche, il est devenu le partenaire systématique de toutes mes évolutions professionnelles."</p>
                  <p class="testimonial-author"><strong>Rémi Forsans</strong></p>
                  <p class="testimonial-job">Fondateur OSV et iDÉE</p>
               </div>
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">"Notre rencontre avec Jean-Marc Favre a été un véritable cadeau pour MEEO ! Son écoute, son optimisme communicatif, sa capacité à s'émerveiller et voir le beau partout… Par ses images, Jean-Marc a retranscrit avec tant de sensibilité, de respect et d'émotions le quotidien des enfants, le combat de leurs parents et de l'Association !"</p>
                  <p class="testimonial-author"><strong>Félicie Petit</strong></p>
                  <p class="testimonial-job">Co-fondatrice et directrice de l'école MéeO</p>
               </div>
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">"J'ai eu la chance de faire travailler Jean Marc en tant que pilote de drone sur des événements comme l'Evian Masters ou encore des pubs pour Orange : au delà d'avoir la garantie d'un travail de qualité, c'était surtout une belle aventure humaine et vraie."</p>
                  <p class="testimonial-author"><strong>Frank Pedretti</strong></p>
                  <p class="testimonial-job">Multiglisseur et présentateur France2</p>
               </div>
               <div class="testimonial-item slider-item">
                  <p class="testimonial-text">« Résolument tourné vers le sport, l'environnement et le bien-vivre, Jean-Marc s'exerce toujours à la pointe artistique de l'excellence. Sa vision aiguisée est très précieuse pour la Fondation Eau Neige et Glace qu'il soutient généreusement depuis plus de 10 ans. »</p>
                  <p class="testimonial-author"><strong>Serge Martinot</strong></p>
                  <p class="testimonial-job">Président de la Fondation Eau Neige et Glace</p>
               </div>
            </div>
         </div>
         <div class="slider-navigation">
            <div class="slider-navigation-arrows">
               <button id="prevTestimonial" class="slider-arrow prev-arrow" aria-label="Témoignage précédent">⟵</button>
               <button id="nextTestimonial" class="slider-arrow next-arrow" aria-label="Témoignage suivant">⟶</button>
            </div>
         </div>
      </div>
   </section>

   <section class="pnc-cta container pt-3 pb-5">
      <div class="container-content text-center">
         <h2>Un projet en tête ?</h2>
         <p>Discutons de vos besoins en photo, vidéo ou drone. Devis gratuit et réponse sous 24-48h.</p>
         <a href="/#contact" class="link" aria-label="Accéder à la section contact">Contactez-moi</a>
      </div>
   </section>

</Layout>

<script is:inline>
function initializeSlider(trackSelector, prevButtonId, nextButtonId, scrollAmount) {
  const sliderTrack = document.querySelector(trackSelector);
  const prevButton = document.getElementById(prevButtonId);
  const nextButton = document.getElementById(nextButtonId);
  if (!sliderTrack || !prevButton || !nextButton) return;

  nextButton.addEventListener('click', () => {
    sliderTrack.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
  prevButton.addEventListener('click', () => {
    sliderTrack.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  const updateArrows = () => {
    prevButton.disabled = sliderTrack.scrollLeft <= 1;
    nextButton.disabled = sliderTrack.scrollLeft + sliderTrack.clientWidth >= sliderTrack.scrollWidth - 1;
  };
  sliderTrack.addEventListener('scroll', updateArrows);
  updateArrows();
}

document.addEventListener('DOMContentLoaded', () => {
  const firstItem = document.querySelector('.testimonial-slider-track .slider-item');
  const amount = firstItem ? firstItem.offsetWidth + (parseFloat(getComputedStyle(firstItem).marginRight) || 0) : 400;
  initializeSlider('.testimonial-slider-track', 'prevTestimonial', 'nextTestimonial', amount);
});
</script>
