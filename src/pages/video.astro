---
import Layout from "../layouts/Layout.astro";
import VimeoShowcase from "../components/VimeoShowcase.astro"; 
import ShowcaseVideo from '../components/ShowcaseVideo.astro';
import StructuredData from '../components/StructuredData.astro';
import FaqSection from '../components/FaqSection.astro';

const videoFaqs = [
  {
    question: "Quels types de vidéos réalisez-vous ?",
    answer: "Événements, reportages institutionnels, documentaires, interviews, tutoriels, captation de spectacles/conférences, et contenus pour les réseaux sociaux — de la conception au montage.",
  },
  {
    question: "Pouvez-vous combiner vidéo au sol et drone ?",
    answer: "Oui. Beaucoup de projets mélangent captation sol et prises de vue aériennes pour un rendu plus vivant. Les contraintes réglementaires drone sont gérées en amont.",
  },
  {
    question: "Combien coûte une production vidéo ?",
    answer: "Le budget dépend de la durée de tournage, du montage, des déplacements et d’éventuelles options (drone, multi-caméras). Un devis personnalisé est établi après le brief.",
  },
  {
    question: "Sous quel délai livrez-vous le film ?",
    answer: "Un court format réseaux sociaux peut être livré rapidement ; un film corporate ou reportage demande généralement plus de temps de montage. Le délai est validé avant le tournage.",
  },
  {
    question: "Dans quelles zones filmez-vous ?",
    answer: "Base à Annecy, tournages en Haute-Savoie, Savoie et Auvergne-Rhône-Alpes. Déplacements plus lointains possibles selon le projet.",
  },
  {
    question: "Proposez-vous des formats adaptés aux réseaux sociaux ?",
    answer: "Oui — formats verticaux ou carrés, versions courtes et versions longues, selon vos plateformes (Instagram, LinkedIn, YouTube, site web).",
  },
];
---

<Layout 
  hasHero={true}
  title="Vidéaste Professionnel Annecy | Production Vidéo - Jean-Marc Favre"
  description="Vidéaste et réalisateur professionnel à Annecy. Production vidéo entreprise, événements, documentaires, clips. 40 ans d'expérience audiovisuelle en Haute-Savoie."
  image="/images/parallax/180218-nazare-surf-725-1142x758.jpg"
  preloadImage="/images/parallax/180218-nazare-surf-725-1142x758.jpg"
  canonical="/video/"
>
<StructuredData type="ImageObject" data={{
  url: "/images/parallax/180218-nazare-surf-725-1142x758.jpg",
  caption: "Production vidéo professionnelle — Jean-Marc Favre",
  name: "Vidéo — Jean-Marc Favre",
  contentLocation: "Annecy, Haute-Savoie"
}} />

   <section class="page-hero">
      <div class="page-hero__image">
         <img src="/images/parallax/180218-nazare-surf-725-1142x758.jpg" alt="Production vidéo professionnelle - Jean-Marc Favre" loading="eager">
      </div>
      <div class="page-hero__overlay"></div>
      <div class="page-hero__content">
         <h1 class="page-hero__title">Vidéo</h1>
      </div>
   </section>

<section class="prestations-section prestations-video pt-1 pb-3">
   <div class="container-content">
         <div class="text-wrap pb-2">
            <h2>Production & Réalisation Vidéo en Auvergne-Rhône-Alpes</h2>
            <div class="text-wrapper">
               <p>La vidéo est aujourd’hui un outil incontournable pour captiver votre audience et affirmer votre présence en ligne.  </p>
               <p>Je propose des services de <strong>production vidéo</strong> créatives et percutantes , adaptées à vos objectifs de communication pour entreprises et particuliers. De la conception à la postproduction, chaque étape est prise en charge avec rigueur et sens artistique. Grâce à des solutions flexibles, mes prestations s’adaptent à tous les budgets sans compromis sur la qualité.</p>
            </div>
            <div class="separation-line-gradient"></div>
            <div class="text-wrapper">
               <h3 class="text-center">Prestations proposées :</h3>
               <ul style="columns: 2; gap: 2rem; list-style: disc inside;">
                  <li>Couverture d’événements (entreprises, festivals, touristiques)</li>
                  <li>Réalisation de tutoriels vidéo</li>
                  <li>Captation de spectacles ou conférences</li>
                  <li>Reportages institutionnels ou documentaires</li>
                  <li>Interviews & témoignages clients</li>
                  <li>Création de contenus pour les réseaux sociaux</li>
               </ul>
            </div>
            <p class="text-center">
               <b><a class="link-text" href="/#contact">Contactez-moi</a> pour toute information supplémentaire ainsi que pour discuter de votre projet et obtenir un devis personnalisé ajusté au plus près.</b>
            </p>
         </div>
   </div>
</section>

<section class="showcase-video-section">
   <ShowcaseVideo />
</section>
   

   <section class="parallax-banner" style="background-image: url('/images/parallax/180727-Viaduc_Millau-049.jpg');">
   <div class="parallax-banner-overlay"></div> 
   <img 
      src="/images/parallax/180727-Viaduc_Millau-049.jpg" 
      alt="Chateau de Duingt" 
      class="parallax-mobile-img" 
      loading="lazy"
   >
   </section>

<!-- Video Projects -->
<section class="video-projects-section">
   <div class="container-slider-grid">
      <div class="slider-grid-header slider-grid-header-line">
         <div class="title-wrapper link-flex">
            <h2>Projets clients</h2>
            <a class="link" href="https://vimeo.com/showcase/11819723" target="_blank" aria-label="Voir plus de projets clients">Voir plus de projets clients</a>
         </div>
      </div>
      <div class="slider-grid-wrapper">
         <VimeoShowcase showcaseId="11819723" />
      </div>
   </div>
</section>

<section class="video-socials-section">
   <div class="container-content">
         <div class="socials-video">
            <h3 class="text-center mb-2">ACCÉDEZ À MES CONTENUS VIDÉO</h3>
            <div class="socials-wrapper">
               <a href="https://vimeo.com/wooloomoolootv" target="_blank" aria-label="Vimeo">
               <img src="/images/icons/vimeo.svg" alt="Vimeo" class="icon" width="40" height="40">
               </a>
               <a href="https://www.youtube.com/channel/UCd_1Z_BMT7yLnsGuzrCtrkw" target="_blank" aria-label="YouTube">
               <img src="/images/icons/youtube.svg" alt="YouTube" class="icon" width="40" height="40">
               </a>
            </div>
      </div>
   </div>
</section>

<FaqSection items={videoFaqs} />

</Layout>
